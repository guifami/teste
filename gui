@Autowired
private PaymentApiClient paymentApiClient;

public PixTransactionDto pixPaymentValidation(PixPaymentDto pixPaymentValidationDto) {
    sameOwnershipValidation(pixPaymentValidationDto);
    validateKeyEvp(pixPaymentValidationDto);

    var appInfo = getAppInfo(strings);

    PaymentRequestDTOV2 paymentRequest =
            bspiPaymentValidationMapper.toPaymentRequestDTOV2(
                    pixPaymentValidationDto,
                    appInfo.getCustomer()
            );

    BspiPaymentV2Builder requestBuilder = new BspiPaymentV2Builder(paymentRequest);

    BspiPaymentIntentionV2Builder response =
            paymentApiClient.intentionPaymentV3(
                    bspiMapper.createHeader(appInfo),
                    getBspiDeviceData(),
                    requestBuilder
            );

    return bspiPaymentValidationMapper.toPixTransactionDto(
            response.getWrapped(),
            pixPaymentValidationDto
    );
}


// ====================== BspiPaymentValidationMapper.java ======================

public PaymentRequestDTOV2 toPaymentRequestDTOV2(
        PixPaymentDto dto,
        CustomerInfo customerInfo) {

    PaymentRequestDTOV2 request = new PaymentRequestDTOV2();

    request.setCanal(String.valueOf(CHANNEL_ID));
    request.setTipoExecucao(PaymentRequestDTOV2.TipoExecucaoEnum.O);

    if (dto.getInputMethod() != null && dto.getInputMethod().getCodeInd() != null) {
        request.setTipoIniciacao(
                PaymentRequestDTOV2.TipoIniciacaoEnum.fromValue(
                        dto.getInputMethod().getCodeInd()
                )
        );
    }

    if (dto.getPixTransPurposeEnum() != null) {
        request.setFinalidadeTransacao(
                PaymentRequestDTOV2.FinalidadeTransacaoEnum.fromValue(
                        dto.getPixTransPurposeEnum().getValue()
                )
        );
    }

    if (dto.getTransactionAmount() != null) {
        request.setValor(
                dto.getTransactionAmount()
                        .setScale(2, RoundingMode.HALF_UP)
                        .toPlainString()
        );
    }

    request.setDescricao(dto.getDescription());
    request.setE2e(dto.getConfirmationCode());
    request.setChave(createPaymentChave(dto));
    request.setDebito(createPaymentDebito(dto, customerInfo));
    request.setCredito(createPaymentCredito(dto));
    request.setLiop(createPaymentLiop(dto));
    request.setCafd(createPaymentCafd(dto.getCafdConfirmationDto()));
    request.setUtilizaCartaoCredito(Boolean.FALSE);
    request.setUtilizaBiometria(Boolean.FALSE);

    return request;
}

private ChaveDTO createPaymentChave(PixPaymentDto dto) {
    if (dto.getRecipientKeyType() == null ||
            PixNumericKeyTypeEnum.BRANCH_ACCOUNT.equals(dto.getRecipientKeyType())) {
        return null;
    }

    ChaveDTO chave = new ChaveDTO();

    switch (dto.getRecipientKeyType()) {
        case EMAIL:
            chave.setTipo(ChaveDTO.TipoEnum.EMAIL);
            break;
        case PHONE:
            chave.setTipo(ChaveDTO.TipoEnum.CELULAR);
            break;
        case CPF_CNPJ:
            chave.setTipo(ChaveDTO.TipoEnum.CPF_CNPJ);
            break;
        case EVP:
            chave.setTipo(ChaveDTO.TipoEnum.EVP);
            break;
        default:
            return null;
    }

    chave.setValor(dto.getRecipientKey());
    return chave;
}

private DebitoDTO createPaymentDebito(
        PixPaymentDto dto,
        CustomerInfo customerInfo) {

    DebitoDTO debito = new DebitoDTO();

    debito.setIspb(String.valueOf(INTERNAL_BANK_ISPB));
    debito.setBanco(String.valueOf(INTERNAL_BANK_CODE));

    if (customerInfo != null) {
        if (customerInfo.getBranch() != null) {
            debito.setAgencia(String.valueOf(customerInfo.getBranch()));
        }

        if (customerInfo.getAccountNumber() != null) {
            debito.setConta(String.valueOf(customerInfo.getAccountNumber()));
            debito.setDigitoConta(getAccountDigit(customerInfo.getAccountNumber()));
        }
    }

    if (dto.getSenderAccountType() != null) {
        switch (dto.getSenderAccountType()) {
            case CURRENT:
                debito.setTipoConta(DebitoDTO.TipoContaEnum.CACC);
                break;
            case SAVING:
                debito.setTipoConta(DebitoDTO.TipoContaEnum.SVGS);
                break;
            default:
                break;
        }
    }

    try {
        var bankingCustomer = customerService.findBankingCustomer();

        if (bankingCustomer != null) {
            debito.setNome(
                    truncateToMaxChars(
                            bankingCustomer.getName(),
                            KEY_CREATION_TRUNCATE_SENDERNAME
                    )
            );
        }
    } catch (RuntimeException ignored) {
    }

    return debito;
}

private CreditoDTO createPaymentCredito(PixPaymentDto dto) {
    CreditoDTO credito = new CreditoDTO();

    if (dto.getRecipientIspbCode() != null) {
        credito.setIspb(getFormattedIspb(dto.getRecipientIspbCode()));
    }

    if (dto.getRecipientBranch() != null) {
        credito.setAgencia(String.valueOf(dto.getRecipientBranch()));
    }

    if (dto.getRecipientAccount() != null) {
        credito.setConta(String.valueOf(dto.getRecipientAccount()));
    }

    if (dto.getRecipientAccountDigit() != null) {
        credito.setDigitoConta(String.valueOf(dto.getRecipientAccountDigit()));
    }

    if (dto.getRecipientName() != null) {
        credito.setNome(
                truncateToMaxChars(
                        dto.getRecipientName(),
                        KEY_CREATION_TRUNCATE_RECIPIENT_NAME
                )
        );
    }

    if (dto.getRecipientAccountType() != null) {
        switch (dto.getRecipientAccountType()) {
            case CURRENT:
                credito.setTipoConta(CreditoDTO.TipoContaEnum.CACC);
                break;
            case SAVING:
                credito.setTipoConta(CreditoDTO.TipoContaEnum.SVGS);
                break;
            case PAYMENT_ACCOUNT:
                credito.setTipoConta(CreditoDTO.TipoContaEnum.TRAN);
                break;
            default:
                break;
        }
    }

    return credito;
}

private LiopDTO createPaymentLiop(PixPaymentDto dto) {
    LiopDTO liop = new LiopDTO();

    liop.setCanal(String.valueOf(CHANNEL_ID));

    if (dto.getInputMethod() != null) {
        if (dto.getInputMethod().getLimitServiceCode() != null) {
            liop.setServico(
                    String.valueOf(dto.getInputMethod().getLimitServiceCode())
            );
        }

        if (dto.getInputMethod().getMagicLimitServiceCode() != null) {
            liop.setServicoRetirada(
                    String.valueOf(dto.getInputMethod().getMagicLimitServiceCode())
            );
        }
    }

    return liop;
}

private CafdDTOV2 createPaymentCafd(CafdConfirmationDto dto) {
    CafdDTOV2 cafd = new CafdDTOV2();

    cafd.setCanal(String.valueOf(CHANNEL_ID));
    cafd.setCodigoA(EMPTY_STRING);
    cafd.setNumProtocoloCafd(BigDecimal.ZERO.toString());

    if (dto == null) {
        return cafd;
    }

    cafd.setAgenteUsuario(dto.getUserAgent());
    cafd.setCodSessao(dto.getSessionCode());
    cafd.setEnderecoIp(dto.getIpAddress());
    cafd.setPortaIp(dto.getIpPort());
    cafd.setFormaAcesso(dto.getAccessForm());
    cafd.setIdentEquipam(dto.getEquipmentIdentification());
    cafd.setIdentRegDispos(dto.getIdentRegDevice());
    cafd.setIdentVirtHard(dto.getIdentVirtHard());
    cafd.setLatitude(dto.getLatitude());
    cafd.setLongitude(dto.getLongitude());
    cafd.setModDispositivo(dto.getModelDevice());
    cafd.setNomeUsuario(dto.getUserName());
    cafd.setPlataforma(dto.getPlatform());

    return cafd;
}

public PixTransactionDto toPixTransactionDto(
        IntencaoResponseV2 response,
        PixPaymentDto pixPaymentDto) {

    if (response == null ||
            response.getOnline() == null ||
            response.getOnline().getInfo() == null) {

        throw new UnprocessableEntityException(
                PIX_GENERAL_ERROR.getCode(),
                PIX_GENERAL_ERROR,
                strings
        );
    }

    InfoIntencaoOnline info = response.getOnline().getInfo();
    PixTransactionDto dto = new PixTransactionDto();

    dto.setRecipientName(pixPaymentDto.getRecipientName());
    dto.setRecipientCpfCnpj(getPaymentRecipientCpfCnpj(pixPaymentDto));
    dto.setRecipientBank(pixPaymentDto.getRecipientBank());
    dto.setRecipientKey(pixPaymentDto.getRecipientKey());
    dto.setDescription(pixPaymentDto.getDescription());
    dto.setAmount(pixPaymentDto.getTransactionAmount());
    dto.setRecipientAccount(pixPaymentDto.getRecipientAccount());
    dto.setRecipientBranch(pixPaymentDto.getRecipientBranch());
    dto.setSameOwnership(pixPaymentDto.getSameOwnership());
    dto.setPixTransPurposeEnum(pixPaymentDto.getPixTransPurposeEnum());

    if (pixPaymentDto.getRecipientAccountType() != null) {
        dto.setRecipientAccountType(
                getPixRecipientAccountType(
                        pixPaymentDto.getRecipientAccountType()
                )
        );
    }

    dto.setConfirmationCode(info.getE2e());

    String protocoloCafd =
            info.getProtocoloCafd() != null
                    ? String.valueOf(info.getProtocoloCafd())
                    : BigDecimal.ZERO.toString();

    String codigoA =
            info.getCodigoA() != null
                    ? info.getCodigoA().getValue()
                    : EMPTY_STRING;

    dto.setInternalCode(
            encodeInternalCode(
                    protocoloCafd,
                    codigoA
            )
    );

    if (info.getTarifa() != null && !info.getTarifa().trim().isEmpty()) {
        try {
            dto.setBankFeeAmount(
                    new BigDecimal(
                            info.getTarifa().replace(",", ".")
                    )
            );
        } catch (NumberFormatException ignored) {
            dto.setBankFeeAmount(BigDecimal.ZERO);
        }
    } else {
        dto.setBankFeeAmount(BigDecimal.ZERO);
    }

    if (info.getLimite() != null) {
        dto.setUsesLimitInPaymentEnum(
                PixUseLimitInPaymentEnum.getByExternalCode(
                        info.getLimite()
                )
        );
    }

    dto.setLimits(getPixUsedLimitsV3(info.getLimites()));
    dto.setConfirmationNumber(null);
    dto.setAwaitingAnalysis(Boolean.FALSE);

    return dto;
}

private List<PixUsedLimitDto> getPixUsedLimitsV3(List<Limite> limites) {
    if (limites == null || limites.isEmpty()) {
        return Collections.emptyList();
    }

    List<PixUsedLimitDto> result = new ArrayList<>();

    for (Limite limite : limites) {
        if (limite == null) {
            continue;
        }

        PixUsedLimitDto target = new PixUsedLimitDto();
        BeanUtils.copyProperties(limite, target);
        result.add(target);
    }

    return result;
}

private String encodeInternalCode(
        String cafdProtocolNumber,
        String codeA) {

    try {
        Map<String, String> elements = new HashMap<>();

        elements.put(CAFD_PROTOCOL, cafdProtocolNumber);
        elements.put(INTERNAL_CODE, codeA);

        String json = writeJava8ValueAsString(elements);

        return encryptionService.encryptDaily(json);

    } catch (JsonProcessingException e) {
        LOG.info("Error while encode internal code", e);
        return EMPTY_STRING;
    }
}
