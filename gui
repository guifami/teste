import static org.testng.Assert.*;

public class PixFavoredServiceTest {

    @InjectMocks
    private PixFavoredService pixFavoredService;

    @Mock
    private ContatosApi contatosApi;

    @Spy
    private B2bFavoredMapper b2bFavoredMapper = Mappers.getMapper(B2bFavoredMapper.class);

    @Mock
    private StringBundle strings;

    @BeforeMethod
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        ReflectionTestUtils.setField(pixFavoredService, "xAccessTokenPix", "mock-access-token");
    }

    @Test
    public void testSearchRecordFavored() {
        mockApplicationUser();

        var requestDto = new PixSearchRecordFavoredDto();
        requestDto.setKeyFavored("71829992180");

        var b2bResponse = getFavoredResponse();
        when(contatosApi.findRecord(eq("mock-access-token"), any(RequestFindRecordDTO.class)))
                .thenReturn(b2bResponse);

        var result = pixFavoredService.searchRecordFavored(requestDto);

        assertNotNull(result);
        assertEquals(result.getPartition(), Integer.valueOf(161));
        assertEquals(result.getFavoredCode(), 1L);
        assertEquals(result.getCpfCnpjFavored(), "718299921");
        assertEquals(result.getIspbCodeFavored(), Integer.valueOf(60746948));
        assertEquals(result.getBankFavored(), Integer.valueOf(0));
        assertEquals(result.getBranchFavored(), Integer.valueOf(0));
        assertEquals(result.getAccountFavored(), Long.valueOf(0));
        assertEquals(result.getDigitFavored(), Integer.valueOf(0));
        assertEquals(result.getKey(), "71829992180");
        assertEquals(result.getName(), "FULANO BELTRANO DA SILVA PERFIL NOVO");

        var captor = ArgumentCaptor.forClass(RequestFindRecordDTO.class);
        verify(contatosApi).findRecord(eq("mock-access-token"), captor.capture());

        var request = captor.getValue();
        assertEquals(request.getCtpoCanal(), String.valueOf(CHANNEL_ID));
        assertEquals(request.getBanco(), String.valueOf(INTERNAL_BANK_CODE));
        assertEquals(request.getChave(), "71829992180");
        assertEquals(request.getCispbBacenFavorecido(), INTERNAL_BANK_ISPB);
        assertNotNull(request.getAgencia());
        assertNotNull(request.getConta());
        assertNull(request.getAgenciaFavorecido());
        assertNull(request.getContaFavorecido());
        assertNull(request.getDigitoFavorecido());
        assertNull(request.getCodigoFavorecido());
    }

    @Test
    public void testSearchRecordFavoredResponseNull() {
        mockApplicationUser();

        var requestDto = new PixSearchRecordFavoredDto();
        requestDto.setKeyFavored("71829992180");

        when(contatosApi.findRecord(eq("mock-access-token"), any(RequestFindRecordDTO.class)))
                .thenReturn(null);

        var result = pixFavoredService.searchRecordFavored(requestDto);

        assertNull(result);
        verify(contatosApi, times(1))
                .findRecord(eq("mock-access-token"), any(RequestFindRecordDTO.class));
    }

    private FavrDTOWithoutChannel getFavoredResponse() {
        var response = new FavrDTOWithoutChannel();
        response.setParticao("161");
        response.setBanco("237");
        response.setAgencia("3750");
        response.setConta("49161");
        response.setCodigoFavorecido("1");
        response.setCcpfCnpjFavorecido("718299921");
        response.setCfilialCnpjFavorecido("0000");
        response.setCctrlCpfFavorecido("80");
        response.setCispbBacenFavorecido("60746948");
        response.setBancoFavorecido("0");
        response.setAgenciaFavorecido("0");
        response.setContaFavorecido("0");
        response.setDigitoFavorecido("0");
        response.setTipoConta(FavrDTOWithoutChannel.TipoContaEnum.CACC);
        response.setChave("71829992180");
        response.setNome("FULANO BELTRANO DA SILVA PERFIL NOVO");
        response.setEntrada(FavrDTOWithoutChannel.EntradaEnum.CPF_CNPJ);
        response.setValorMinimo("");
        response.setValorMaximo("");
        response.setCadastro(FavrDTOWithoutChannel.CadastroEnum.FAVORITO);
        response.setDataInicioValidade("2026-08-14 17:08:15.061");
        response.setStatusCadastro(FavrDTOWithoutChannel.StatusCadastroEnum.ATIVO);
        return response;
    }
}


