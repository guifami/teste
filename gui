    @Test
    public void validationV3_quandoM0076ComAgendamento_deveConsultarScheduleEConstruirContexto() {
        mockServiceCallPaymentValidation();

        PixPaymentDto pixPaymentDto = getPixPaymentDto();
        pixPaymentDto.setTransactionAmount(new BigDecimal("600"));
        pixPaymentDto.setSameOwnership(false);

        LocalDate scheduleDate = LocalDate.now().plusDays(1);
        PixPaymentScheduleDto schedule = new PixPaymentScheduleDto();
        schedule.setScheduleDate(scheduleDate);
        pixPaymentDto.setSchedule(schedule);

        doReturn(getBspiPaymentV2Request()).when(bspiRequestUtils).createBspiPaymentV2Request(any(PixPaymentDto.class));
        when(bspiPaymentEngClient.intentionPaymentV3(any(), any(), any())).thenThrow(FeignCustomExceptionBuilder.createWithCode("M0076"));
        when(pixScheduleQueryService.getScheduledAmountForDate(any(), eq(scheduleDate))).thenReturn(new BigDecimal("500"));

        try (MockedStatic<PixPaymentM0076RuleResolver> resolverMock = mockStatic(PixPaymentM0076RuleResolver.class)) {
            resolverMock.when(() -> PixPaymentM0076RuleResolver.isM0076("M0076")).thenReturn(true);
            resolverMock.when(() -> PixPaymentM0076RuleResolver.resolve(any())).thenReturn(Optional.of(PixPaymentError.PIX_PAYMENT_SCHEDULE_SUM_LIMIT_EXCEEDED));

            try {
                fixture.validationV3(pixPaymentDto);
                fail("Era esperado o lançamento de UnprocessableEntityException");
            } catch (UnprocessableEntityException expected) {
                ArgumentCaptor<PixPaymentM0076ContextDto> captor = ArgumentCaptor.forClass(PixPaymentM0076ContextDto.class);
                resolverMock.verify(() -> PixPaymentM0076RuleResolver.resolve(captor.capture()));

                PixPaymentM0076ContextDto context = captor.getValue();
                assertEquals(context.transactionAmount(), new BigDecimal("600"));
                assertFalse(context.sameOwnership());
                assertEquals(context.scheduleDate(), scheduleDate);
                assertNotNull(context.creationDateTime());
                assertTrue(context.isAgendamento());
                assertEquals(context.existingScheduledAmountForDate(), new BigDecimal("500"));
                assertEquals(context.nextAvailableScheduleDate(), scheduleDate.plusDays(1));
                verify(pixScheduleQueryService).getScheduledAmountForDate(any(), eq(scheduleDate));
            }
        }
    }

    @Test
