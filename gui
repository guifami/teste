    private String xAccessTokenPix;

    @Autowired
    private PixScheduleQueryService pixScheduleQueryService;

    @Value("${banking.accessToken}")
    private String accessToken;

    private static final String IN_ANALYSIS_STATUS_CODE = "E0001";
    private static final String IN_INDEPOTENCY_STATUS_CODE = "E1466";

    @Autowired
    private InternalCodeCryptoUtils internalCodeCryptoUtils;

    public PixPaymentConfirmationResponse confirmationV3(PixPaymentDto pixPaymentDto, String token) {
        // validateOtpV3(token);
        var responseV3 = new PixPaymentConfirmationResponse();
        try {
            var paymentConfirmationV3Response = getPixPaymentConfirmationV3Response(pixPaymentDto);
            if (nonNull(paymentConfirmationV3Response)) {
                validateIndepotencyStatusCodeV3(paymentConfirmationV3Response);
                if (isAwaitingAnalysisV3(paymentConfirmationV3Response)) {
                    return createResponseForAwaitingAnalysisV3(pixPaymentDto);
                }
                if (paymentConfirmationV3Response.isOnline()) {
                    var onlineConfirmationDtoV3 = createOnlineConfirmationDtoV3(paymentConfirmationV3Response);
                    responseV3.setPixPaymentConfirmationOnlineDto(onlineConfirmationDtoV3);
                }
                if (paymentConfirmationV3Response.isScheduled()) {
                    var pixPaymentScheduleInfoResponseV3 = createPixPaymentScheduleInfoResponseV3(paymentConfirmationV3Response);
                    responseV3.setPixPaymentConfirmationScheduleInfoDto(pixPaymentScheduleInfoResponseV3);
                }
            }
        } catch (FeignCustomException ce) {
            LOG.error(BSPL_ERROR_CONFIRM_PAYMENT, ce);
            NextError nextError = resolveM0076Rule(extractBspiRawCode(ce), pixPaymentDto, getByFeignCustomException(ce));
            if (PIX_SECURITY_BLOCK_ERROR.getCode().equals(nextError.getCode())) {
                return createResponseForAwaitingAnalysisV3(pixPaymentDto);
            }
            throw new UnprocessableEntityException(nextError.getCode(), nextError, strings);
        }
        return responseV3;
    }

    public PixPaymentConfirmationResponse createResponseForAwaitingAnalysisV3(PixPaymentDto pixPaymentDto) {
        if (isNull(pixPaymentDto)) {
            throw new UnprocessableEntityException(PIX_PAYMENT_GENERIC_ERROR.getCode(), PIX_PAYMENT_GENERIC_ERROR, strings);
        }
        var responseV3 = new PixPaymentConfirmationResponse();
        responseV3.setConfirmationCode(pixPaymentDto.getConfirmationCode());
        var internalCodeV3 = pixPaymentDto.getInternalCode();
        if (nonNull(internalCodeV3)) {
            var decryptedInternalCode = internalCodeCryptoUtils.decrypt(internalCodeV3);
            var cafdProtocolNumber = decryptedInternalCode.getCafdProtocolNumber();
            responseV3.setCafdProtocolNumber(cafdProtocolNumber);
            responseV3.setCafdProtocol(nonNull(cafdProtocolNumber) ? cafdProtocolNumber.toString() : "");
        }
        responseV3.setAwaitingAnalysis(true);
        return responseV3;
    }

    public boolean isAwaitingAnalysisV3(BspiPaymentConfirmationV2Builder bspiPaymentConfirmationResponse) {
        if (nonNull(bspiPaymentConfirmationResponse) && nonNull(bspiPaymentConfirmationResponse.getBspiPaymentConfirmationOnline())) {
            var bspiPaymentInfoConfirmationOnlineV3 = bspiPaymentConfirmationResponse.getBspiPaymentConfirmationOnline();
            return nonNull(bspiPaymentInfoConfirmationOnlineV3.getWrapped()) && IN_ANALYSIS_STATUS_CODE.equals(bspiPaymentInfoConfirmationOnlineV3.getCode());
        }
        return false;
    }

    public void validateIndepotencyStatusCodeV3(BspiPaymentConfirmationV2Builder bspiPaymentConfirmationResponse) {
        if (nonNull(bspiPaymentConfirmationResponse) && nonNull(bspiPaymentConfirmationResponse.getBspiPaymentConfirmationOnline())) {
            var bspiPaymentInfoConfirmationOnlineV3 = bspiPaymentConfirmationResponse.getBspiPaymentConfirmationOnline();
            var isIndepotenceStatusCodeV3 = nonNull(bspiPaymentInfoConfirmationOnlineV3.getWrapped()) && IN_INDEPOTENCY_STATUS_CODE.equals(bspiPaymentInfoConfirmationOnlineV3.getCode());
            if (isIndepotenceStatusCodeV3) {
                throw new UnprocessableEntityException(PIX_TRANSACTION_INDEPOTENCY_ERROR.getCode(), PIX_TRANSACTION_INDEPOTENCY_ERROR, strings);
            }
        }
    }

    public PixPaymentConfirmationScheduleInfoDto createPixPaymentScheduleInfoResponseV3(BspiPaymentConfirmationV2Builder bspiPaymentConfirmationResponse) {
        var paymentConfirmationScheduleV3Dto = bspiPaymentConfirmationResponse.getBspiPaymentConfirmationScheduleDto();
        PixPaymentConfirmationScheduleInfoDto scheduleInfoDtoV3 = null;
        if (nonNull(paymentConfirmationScheduleV3Dto)) {
            validateBspiScheduleCodeV3(paymentConfirmationScheduleV3Dto);
            scheduleInfoDtoV3 = new PixPaymentConfirmationScheduleInfoDto();
            var bspiPaymentInfoConfirmationScheduleDtoV3 = paymentConfirmationScheduleV3Dto.getBspiPaymentInfoConfirmationScheduleDto();
            String status = bspiPaymentInfoConfirmationScheduleDtoV3.getStatus();
            scheduleInfoDtoV3.setStatus(nonNull(status) ? fromBspiCode(status) : null);
            var schedules = bspiPaymentInfoConfirmationScheduleDtoV3.getBspiPaymentScheduleConfirmationDto();
            if (nonNull(schedules)) {
                var scheduleDtos = new ArrayList<PixPaymentConfirmationScheduleDto>();
                schedules.forEach(schedule -> {
                    var scheduleDto = new PixPaymentConfirmationScheduleDto();
                    scheduleDto.setScheduleDate(schedule.getScheduleDate());
                    scheduleDto.setDuplicateTransaction(schedule.getDuplicateTransaction());
                    scheduleDto.setPartitionCode(schedule.getTablePartition());
                    scheduleDto.setTax(schedule.getTax());
                    scheduleDto.setConfirmationCode(schedule.getE2EO());
                    scheduleDtos.add(scheduleDto);
                });
                scheduleInfoDtoV3.setSchedules(scheduleDtos);
            }
        }
        return scheduleInfoDtoV3;
    }

    public void validateBspiScheduleCodeV3(BspiPaymentConfirmationScheduleMapper bspiPaymentConfirmationScheduleDto) {
        NextError byBspiErrorCodeV3 = getByBspiErrorCodeWithoutGenericError(bspiPaymentConfirmationScheduleDto.getCode());
        if (nonNull(byBspiErrorCodeV3)) {
            throw new UnprocessableEntityException(byBspiErrorCodeV3.getCode(), byBspiErrorCodeV3, strings);
        }
    }

    public PixPaymentConfirmationOnlineDto createOnlineConfirmationDtoV3(BspiPaymentConfirmationV2Builder bspiPaymentConfirmationResponse) {
        PixPaymentConfirmationOnlineDto pixPaymentConfirmationOnlineDtoV3 = null;
        var bspiPaymentConfirmationOnlineV3 = bspiPaymentConfirmationResponse.getBspiPaymentConfirmationOnline();
        if (nonNull(bspiPaymentConfirmationOnlineV3) && nonNull(bspiPaymentConfirmationOnlineV3.getWrapped()) && nonNull(bspiPaymentConfirmationOnlineV3.getBspiPaymentInfoConfirmationOnline())) {
            var bspiPaymentInfoConfirmationOnline = bspiPaymentConfirmationOnlineV3.getBspiPaymentInfoConfirmationOnline();
            pixPaymentConfirmationOnlineDtoV3 = new PixPaymentConfirmationOnlineDto();
            pixPaymentConfirmationOnlineDtoV3.setConfirmationNumber(bspiPaymentInfoConfirmationOnline.getConfirmationCode());
            pixPaymentConfirmationOnlineDtoV3.setConfirmationCode(bspiPaymentInfoConfirmationOnline.getE2EO());
            pixPaymentConfirmationOnlineDtoV3.setOperationDate(bspiPaymentInfoConfirmationOnline.getOperationDate());
            pixPaymentConfirmationOnlineDtoV3.setDocumentNumber(bspiPaymentInfoConfirmationOnline.getDocumentNumber());
            pixPaymentConfirmationOnlineDtoV3.setTax(bspiPaymentInfoConfirmationOnline.getTax());
        }
        return pixPaymentConfirmationOnlineDtoV3;
    }

    public BspiPaymentConfirmationV2Builder getPixPaymentConfirmationV3Response(PixPaymentDto pixPaymentDto) {
        var header = createHeaderV2(pixPaymentDto.getCpf(), xAccessTokenPix);
        var bspiPaymentRequestV3 = bspiRequestUtils.createBspiPaymentV2Request(pixPaymentDto);
        return ofNullable(paymentApiClient.confirmPaymentV3(header, getBspiDeviceData(), bspiPaymentRequestV3)).orElseThrow(() -> {
            LOG.error(BSPL_ERROR_EMPTY_RESPONSE_CONFIRM_PAYMENT);
            return new UnprocessableEntityException(BSPL_ERROR_EMPTY_RESPONSE_CONFIRM_PAYMENT);
        });
    }

    public void validateOtpV3(String mobileToken) {
        try {
            var requestV3 = new ValidateSignatureRequest();
            var otpTokenV3 = frontEndEncryptionService.decryptMsg(mobileToken);
            var otpInfoV3 = getOtpInfo(otpTokenV3);
            requestV3.setOtp(otpInfoV3.otp());
            requestV3.setCpf(otpInfoV3.cpf());
            requestV3.setTransaction(otpInfoV3.transacao());
            otpValidationClient.validateSignature(requestV3, accessToken);
        } catch (CoreBankingException ce) {
            NextError nextError = getByCoreBankException(ce);
            LOG.error("Error validating OTP: {}", nextError.getMessageKey(), ce);
            throw new UnprocessableEntityException(nextError.getCode(), nextError, strings);
        }
    }

    private NextError resolveM0076Rule(String bspiReturnCode, PixPaymentDto pixPaymentDto, NextError defaultError) {
        if (!PixPaymentM0076RuleResolver.isM0076(bspiReturnCode)) {
            return defaultError;
        }
        PixPaymentScheduleDto schedule = pixPaymentDto.getSchedule();
        LocalDate scheduleDate = nonNull(schedule) ? schedule.getScheduleDate() : null;
        BigDecimal existingScheduledAmount = nonNull(scheduleDate) ? pixScheduleQueryService.getScheduledAmountForDate(xAccessTokenPix, scheduleDate) : BigDecimal.ZERO;
        var context = new PixPaymentM0076ContextDto(pixPaymentDto.getTransactionAmount(), pixPaymentDto.isSameOwnership(), scheduleDate, LocalDateTime.now(), nonNull(schedule), existingScheduledAmount, nonNull(scheduleDate) ? scheduleDate.plusDays(1) : null);
        return PixPaymentM0076RuleResolver.resolve(context).orElse(defaultError);
    }
}













