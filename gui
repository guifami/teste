@Test
public void getScheduledAmountForDate_deveIgnorarInvalidosCanceladosENulosESomarValoresValidos() throws Exception {
    PixScheduleResponse response = mock(PixScheduleResponse.class);

    PixScheduleDto canceledSchedule = mock(PixScheduleDto.class);
    Class<?> cancelationReasonType = PixScheduleDto.class.getMethod("getCancelationReason").getReturnType();
    Object cancelationReason = cancelationReasonType.isEnum() ? cancelationReasonType.getEnumConstants()[0] : mock(cancelationReasonType);
    doReturn(cancelationReason).when(canceledSchedule).getCancelationReason();

    PixScheduleDto withoutPaymentData = mock(PixScheduleDto.class);
    when(withoutPaymentData.getCancelationReason()).thenReturn(null);

    PixScheduleDto nullOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
    when(nullOperationValue.getCancelationReason()).thenReturn(null);
    when(nullOperationValue.getPaymentData().getOperationValue()).thenReturn(null);

    PixScheduleDto blankOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
    when(blankOperationValue.getCancelationReason()).thenReturn(null);
    when(blankOperationValue.getPaymentData().getOperationValue()).thenReturn(" ");

    PixScheduleDto invalidOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
    when(invalidOperationValue.getCancelationReason()).thenReturn(null);
    when(invalidOperationValue.getPaymentData().getOperationValue()).thenReturn("valor-invalido");

    PixScheduleDto validSchedule1 = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
    when(validSchedule1.getCancelationReason()).thenReturn(null);
    when(validSchedule1.getPaymentData().getOperationValue()).thenReturn("100.50");

    PixScheduleDto validSchedule2 = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
    when(validSchedule2.getCancelationReason()).thenReturn(null);
    when(validSchedule2.getPaymentData().getOperationValue()).thenReturn("200.25");

    when(response.getSchedules()).thenReturn(Arrays.asList(null, canceledSchedule, withoutPaymentData, nullOperationValue, blankOperationValue, invalidOperationValue, validSchedule1, validSchedule2));
    when(nextPixScheduleClient.getV3ListSchedulesPaginated(eq(TOKEN), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull())).thenReturn(response);

    BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, DATE);

    assertEquals(result, new BigDecimal("300.75"));
}






package br.com.bradesco.next.pix.payment.service;

import br.com.bradesco.next.client.next.pix.schedule.NextPixScheduleClient;
import br.com.bradesco.next.client.next.pix.schedule.dto.PixScheduleDto;
import br.com.bradesco.next.client.next.pix.schedule.response.PixScheduleResponse;
import feign.FeignException;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.Arrays;

import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.ArgumentMatchers.isNull;
import static org.mockito.Mockito.RETURNS_DEEP_STUBS;
import static org.mockito.Mockito.doReturn;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import static org.testng.Assert.assertEquals;

public class PixScheduleQueryServiceTest {

    private static final String TOKEN = "token";
    private static final LocalDate DATE = LocalDate.of(2026, 8, 28);

    @InjectMocks
    private PixScheduleQueryService fixture;

    @Mock
    private NextPixScheduleClient nextPixScheduleClient;

    @BeforeMethod
    public void setUp() {
        MockitoAnnotations.openMocks(this);
    }

    @Test
    public void getScheduledAmountForDate_quandoTokenNulo_deveRetornarZero() {
        BigDecimal result = fixture.getScheduledAmountForDate(null, DATE);
        assertEquals(result, BigDecimal.ZERO);
        verify(nextPixScheduleClient, never()).getV3ListSchedulesPaginated(isNull(), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull());
    }

    @Test
    public void getScheduledAmountForDate_quandoDataNula_deveRetornarZero() {
        BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, null);
        assertEquals(result, BigDecimal.ZERO);
        verify(nextPixScheduleClient, never()).getV3ListSchedulesPaginated(eq(TOKEN), isNull(), isNull(), isNull(), isNull(), isNull(), isNull(), isNull(), isNull());
    }

    @Test
    public void getScheduledAmountForDate_quandoResponseNulo_deveRetornarZero() {
        when(nextPixScheduleClient.getV3ListSchedulesPaginated(eq(TOKEN), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull())).thenReturn(null);
        BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, DATE);
        assertEquals(result, BigDecimal.ZERO);
    }

    @Test
    public void getScheduledAmountForDate_quandoSchedulesNulo_deveRetornarZero() {
        PixScheduleResponse response = mock(PixScheduleResponse.class);
        when(response.getSchedules()).thenReturn(null);
        when(nextPixScheduleClient.getV3ListSchedulesPaginated(eq(TOKEN), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull())).thenReturn(response);
        BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, DATE);
        assertEquals(result, BigDecimal.ZERO);
    }

    @Test
    public void getScheduledAmountForDate_quandoFeignException_deveRetornarZero() {
        FeignException exception = mock(FeignException.class);
        when(nextPixScheduleClient.getV3ListSchedulesPaginated(eq(TOKEN), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull())).thenThrow(exception);
        BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, DATE);
        assertEquals(result, BigDecimal.ZERO);
    }

    @Test
    public void getScheduledAmountForDate_deveIgnorarInvalidosCanceladosENulosESomarValoresValidos() throws Exception {
        PixScheduleResponse response = mock(PixScheduleResponse.class);

        PixScheduleDto canceledSchedule = mock(PixScheduleDto.class);
        Class<?> cancelationReasonType = PixScheduleDto.class.getMethod("getCancelationReason").getReturnType();
        Object cancelationReason = cancelationReasonType.isEnum() ? cancelationReasonType.getEnumConstants()[0] : mock(cancelationReasonType);
        doReturn(cancelationReason).when(canceledSchedule).getCancelationReason();

        PixScheduleDto withoutPaymentData = mock(PixScheduleDto.class);

        PixScheduleDto nullOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
        when(nullOperationValue.getPaymentData().getOperationValue()).thenReturn(null);

        PixScheduleDto blankOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
        when(blankOperationValue.getPaymentData().getOperationValue()).thenReturn("   ");

        PixScheduleDto invalidOperationValue = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
        when(invalidOperationValue.getPaymentData().getOperationValue()).thenReturn("valor-invalido");

        PixScheduleDto validSchedule1 = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
        when(validSchedule1.getPaymentData().getOperationValue()).thenReturn("100.50");

        PixScheduleDto validSchedule2 = mock(PixScheduleDto.class, RETURNS_DEEP_STUBS);
        when(validSchedule2.getPaymentData().getOperationValue()).thenReturn("200.25");

        when(response.getSchedules()).thenReturn(Arrays.asList(null, canceledSchedule, withoutPaymentData, nullOperationValue, blankOperationValue, invalidOperationValue, validSchedule1, validSchedule2));
        when(nextPixScheduleClient.getV3ListSchedulesPaginated(eq(TOKEN), eq(DATE), eq(DATE), isNull(), isNull(), isNull(), isNull(), isNull(), isNull())).thenReturn(response);

        BigDecimal result = fixture.getScheduledAmountForDate(TOKEN, DATE);

        assertEquals(result, new BigDecimal("300.75"));
    }
}
