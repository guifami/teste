package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.FavrDTOWithoutChannel;
import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.RequestFindRecordDTO;
import br.com.bradesco.next.contingency.pix.domain.dto.PixFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.enums.PixAccountTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixFavoredTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationStatusEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationTypeFavoredEnum;
import org.springframework.stereotype.Component;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

@Component
public class B2bFavoredMapper {

    public RequestFindRecordDTO toRequest(String keyFavored, String bank, String branch, String account, String channel) {
        var request = new RequestFindRecordDTO();
        request.setCtpoCanal(channel);
        request.setBanco(bank);
        request.setAgencia(branch);
        request.setConta(account);
        request.setChave(keyFavored);
        return request;
    }

    public PixFavoredDto toPixFavoredDto(FavrDTOWithoutChannel source) {
        if (source == null) return null;

        var target = new PixFavoredDto();
        target.setPartition(parseInteger(source.getParticao()));
        target.setFavoredCode(parseLong(source.getCodigoFavorecido()));
        target.setLegalPersonCodeFavored(defaultLong(source.getCcpfCnpjFavorecido()));
        target.setContractTypeCodeFavored(defaultInteger(source.getCfilialCnpjFavorecido()));
        target.setContractSequentialNumberFavored(defaultLong(source.getCctrlCpfFavorecido()));
        target.setCpfCnpjFavored(buildCpfCnpj(
                source.getCcpfCnpjFavorecido(),
                source.getCfilialCnpjFavorecido(),
                source.getCctrlCpfFavorecido()
        ));
        target.setIspbCodeFavored(parseInteger(source.getCispbBacenFavorecido()));
        target.setBankFavored(parseInteger(source.getBancoFavorecido()));
        target.setBranchFavored(parseInteger(source.getAgenciaFavorecido()));
        target.setAccountFavored(parseLong(source.getContaFavorecido()));
        target.setDigitFavored(parseInteger(source.getDigitoFavorecido()));
        target.setTypeAccount(mapEnum(source.getTipoConta(), PixAccountTypeEnum.class));
        target.setKey(source.getChave());
        target.setName(source.getNome());
        target.setInput(mapEnum(source.getEntrada(), PixRegistrationTypeFavoredEnum.class));
        target.setRegister(mapEnum(source.getCadastro(), PixFavoredTypeEnum.class));
        target.setStartValidityDate(parseLocalDateTime(source.getDataInicioValidade()));
        target.setRegistrationStatus(mapEnum(source.getStatusCadastro(), PixRegistrationStatusEnum.class));
        return target;
    }

    private Integer parseInteger(String value) {
        var valueParsed = normalizeNumber(value);
        return valueParsed == null ? null : Integer.valueOf(valueParsed);
    }

    private Long parseLong(String value) {
        var valueParsed = normalizeNumber(value);
        return valueParsed == null ? null : Long.valueOf(valueParsed);
    }

    private int defaultInteger(String value) {
        var parsed = parseInteger(value);
        return parsed == null ? 0 : parsed;
    }

    private long defaultLong(String value) {
        var parsed = parseLong(value);
        return parsed == null ? 0L : parsed;
    }

    private String normalizeNumber(String value) {
        if (value == null || value.trim().isEmpty()) return null;
        var result = value.replaceAll("[^0-9]", "");
        return result.isEmpty() ? null : result;
    }

    private String buildCpfCnpj(String base, String branch, String control) {
        var normalizedBase = normalizeNumber(base);
        var normalizedBranch = normalizeNumber(branch);
        var normalizedControl = normalizeNumber(control);

        if (normalizedBase == null) return null;
        if (normalizedBase.length() == 11 || normalizedBase.length() == 14) return normalizedBase;
        if (normalizedBase.length() == 9) return leftPad(normalizedBase, 9) + leftPad(normalizedControl, 2);
        if (normalizedBase.length() <= 8) {
            return leftPad(normalizedBase, 8) + leftPad(normalizedBranch, 4) + leftPad(normalizedControl, 2);
        }
        return normalizedBase;
    }

    private String leftPad(String value, int size) {
        var normalized = value == null ? "" : value;
        if (normalized.length() >= size) return normalized;
        return String.format("%" + size + "s", normalized).replace(' ', '0');
    }

    private <T extends Enum<T>> T mapEnum(Enum<?> source, Class<T> targetClass) {
        if (source == null) return null;
        return Enum.valueOf(targetClass, source.name());
    }

    private LocalDateTime parseLocalDateTime(String value) {
        if (value == null || value.trim().isEmpty()) return null;
        return LocalDateTime.parse(value, DateTimeFormatter.ISO_LOCAL_DATE_TIME);
    }
}


