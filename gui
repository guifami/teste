    @Test
    public void confirmationV3_quandoM0076ComAgendamento_deveConsultarScheduleEEnviarSomatorioAoResolver() {
        PixPaymentDto pixPaymentDto = getPixPaymentDto();
        pixPaymentDto.setTransactionAmount(new BigDecimal("600"));
        pixPaymentDto.setSameOwnership(false);
        LocalDate scheduleDate = LocalDate.now().plusDays(1);
        PixPaymentScheduleDto schedule = new PixPaymentScheduleDto();
        schedule.setScheduleDate(scheduleDate);
        pixPaymentDto.setSchedule(schedule);

        FeignCustomException feignException = mockConfirmationException();
        NextError defaultError = mockDefaultError();
        when(pixScheduleQueryService.getScheduledAmountForDate(SCHEDULE_TOKEN, scheduleDate)).thenReturn(new BigDecimal("500"));

        try (MockedStatic<BspiErrorUtils> bspiErrorMock = mockStatic(BspiErrorUtils.class); MockedStatic<PixPaymentM0076RuleResolver> resolverMock = mockStatic(PixPaymentM0076RuleResolver.class)) {
            bspiErrorMock.when(() -> BspiErrorUtils.extractBspiRawCode(feignException)).thenReturn("M0076");
            bspiErrorMock.when(() -> BspiErrorUtils.getByFeignCustomException(feignException)).thenReturn(defaultError);
            resolverMock.when(() -> PixPaymentM0076RuleResolver.isM0076("M0076")).thenReturn(true);
            resolverMock.when(() -> PixPaymentM0076RuleResolver.resolve(any(PixPaymentM0076ContextDto.class))).thenReturn(Optional.of(PixPaymentError.PIX_PAYMENT_SCHEDULE_SUM_LIMIT_EXCEEDED));

            try {
                fixture.confirmationV3(pixPaymentDto, OTP_TOKEN);
                fail("Era esperado o lançamento de UnprocessableEntityException");
            } catch (UnprocessableEntityException expected) {
                ArgumentCaptor<PixPaymentM0076ContextDto> captor = ArgumentCaptor.forClass(PixPaymentM0076ContextDto.class);
                resolverMock.verify(() -> PixPaymentM0076RuleResolver.resolve(captor.capture()));
                PixPaymentM0076ContextDto context = captor.getValue();

                assertEquals(context.transactionAmount(), new BigDecimal("600"));
                assertFalse(context.sameOwnership());
                assertEquals(context.scheduleDate(), scheduleDate);
                assertNotNull(context.creationDateTime());
                assertTrue(context.isAgendamento());
                assertEquals(context.existingScheduledAmountForDate(), new BigDecimal("500"));
                assertEquals(context.nextAvailableScheduleDate(), scheduleDate.plusDays(1));
                verify(pixScheduleQueryService).getScheduledAmountForDate(SCHEDULE_TOKEN, scheduleDate);
                verify(pixScheduleQueryService, never()).getScheduledAmountForDate(OTP_TOKEN, scheduleDate);
            }
        }
    }

