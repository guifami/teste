        return new PixUpdateLimitResponse(PixUpdateLimitStatusEnum.getByLiopReturnSuccessCode(liopReturnSuccessCode));
    } catch (CoreBankingException coreEx) {
        NextError nextError = getLiopCoreBankMessage(coreEx);
        LOG.error("Update Limit Error: [{}]", coreEx.getMessage());
        throw new UnprocessableEntityException(nextError.getCode(), nextError, strings);
    }
