import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

private static final DateTimeFormatter B2B_DATE_FORMAT =
        DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.SSS");

protected PixAccountTypeEnum map(FavrDTOWithoutChannel.TipoContaEnum value) {
    return value == null ? null : PixAccountTypeEnum.fromValue(value.getValue());
}

protected PixRegistrationTypeFavoredEnum map(FavrDTOWithoutChannel.EntradaEnum value) {
    return value == null ? null : PixRegistrationTypeFavoredEnum.fromValue(value.getValue());
}

protected PixFavoredTypeEnum map(FavrDTOWithoutChannel.CadastroEnum value) {
    return value == null ? null : PixFavoredTypeEnum.fromValue(value.getValue());
}

protected PixRegistrationStatusEnum map(FavrDTOWithoutChannel.StatusCadastroEnum value) {
    return value == null ? null : PixRegistrationStatusEnum.fromValue(value.getValue());
}

protected LocalDateTime map(String value) {
    if (value == null || value.isBlank()) return null;
    return LocalDateTime.parse(value, B2B_DATE_FORMAT);
}
