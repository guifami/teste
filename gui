public class PixPaymentConfirmationV3Service {

    private static final Logger LOG = LoggerFactory.getLogger(PixPaymentConfirmationV3Service.class);
    private static final String BSPL_ERROR_CONFIRM_PAYMENT = "Error calling BSPI service 'confirmPayment': ";
    private static final String BSPL_ERROR_EMPTY_RESPONSE_CONFIRM_PAYMENT = "Error calling BSPI service 'confirmPayment'. Empty response.";

    @Autowired
    private StringBundle strings;

    @Autowired
    private BspiRequestService bspiRequestUtils;

