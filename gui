package br.com.bradesco.next.contingency.pix.service;

import br.com.bradesco.next.common.strings.StringBundle;
import br.com.bradesco.next.common.web.exception.UnprocessableEntityException;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.api.ListaDePaisesApi;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryResponse;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryRootResponse;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountriesDto;
import br.com.bradesco.next.contingency.pix.domain.mapper.core.B2bCountriesMapper;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import java.util.ArrayList;
import java.util.Collections;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import static org.testng.Assert.assertNotNull;
import static org.testng.Assert.assertSame;

public class PixCountriesServiceTest {

    @InjectMocks
    private PixCountriesService pixCountriesService;

    @Mock
    private ListaDePaisesApi listaDePaisesApi;

    @Mock
    private B2bCountriesMapper b2bCountriesMapper;

    @Mock
    private StringBundle strings;

    @BeforeMethod
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void testQueryCountries() {
        var response = getCountryRootResponse();
        var expected = new PixCountriesDto();

        when(listaDePaisesApi.callList()).thenReturn(response);
        when(b2bCountriesMapper.toPixCountriesDto(response)).thenReturn(expected);

        var result = pixCountriesService.queryCountries();

        assertNotNull(result);
        assertSame(result, expected);
        verify(listaDePaisesApi, times(1)).callList();
        verify(b2bCountriesMapper, times(1)).toPixCountriesDto(response);
    }

    @Test(expectedExceptions = UnprocessableEntityException.class)
    public void testQueryCountriesResponseNull() {
        when(listaDePaisesApi.callList()).thenReturn(null);

        pixCountriesService.queryCountries();
    }

    @Test(expectedExceptions = UnprocessableEntityException.class)
    public void testQueryCountriesListNull() {
        var response = new CountryRootResponse();
        response.setListaPaises(null);
        when(listaDePaisesApi.callList()).thenReturn(response);

        pixCountriesService.queryCountries();
    }

    @Test(expectedExceptions = UnprocessableEntityException.class)
    public void testQueryCountriesEmptyList() {
        var response = new CountryRootResponse();
        response.setListaPaises(Collections.emptyList());
        when(listaDePaisesApi.callList()).thenReturn(response);

        pixCountriesService.queryCountries();
    }

    @Test
    public void testMapperNotCalledWhenCountriesInvalid() {
        var response = new CountryRootResponse();
        response.setListaPaises(new ArrayList<>());
        when(listaDePaisesApi.callList()).thenReturn(response);

        try {
            pixCountriesService.queryCountries();
        } catch (UnprocessableEntityException ignored) {
        }

        verify(b2bCountriesMapper, never()).toPixCountriesDto(any());
    }

    private CountryRootResponse getCountryRootResponse() {
        var country = new CountryResponse();
        country.setDdi("55");
        country.setNome("Brasil");

        var response = new CountryRootResponse();
        response.setListaPaises(Collections.singletonList(country));
        return response;
    }
}


