package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryResponse;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryRootResponse;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import java.util.Arrays;

import static org.testng.Assert.*;

public class B2bCountriesMapperTest {

    private B2bCountriesMapper b2bCountriesMapper;

    @BeforeMethod
    public void setUp() {
        b2bCountriesMapper = new B2bCountriesMapper();
    }

    @Test
    public void testToPixCountriesDto() {
        var brasil = country("+55", "Brasil");
        var eua = country("1", "Estados Unidos");

        var response = new CountryRootResponse();
        response.setListaPaises(Arrays.asList(brasil, eua));

        var result = b2bCountriesMapper.toPixCountriesDto(response);

        assertNotNull(result);
        assertEquals(result.getCountries().size(), 2);
        assertEquals(result.getCountries().get(0).getCode(), Integer.valueOf(55));
        assertEquals(result.getCountries().get(0).getName(), "Brasil");
        assertEquals(result.getCountries().get(1).getCode(), Integer.valueOf(1));
        assertEquals(result.getCountries().get(1).getName(), "Estados Unidos");
    }

    @Test
    public void testToPixCountriesDtoWithNullResponse() {
        var result = b2bCountriesMapper.toPixCountriesDto(null);

        assertNotNull(result);
        assertNotNull(result.getCountries());
        assertTrue(result.getCountries().isEmpty());
    }

    @Test
    public void testToPixCountriesDtoWithNullList() {
        var response = new CountryRootResponse();
        response.setListaPaises(null);

        var result = b2bCountriesMapper.toPixCountriesDto(response);

        assertNotNull(result);
        assertTrue(result.getCountries().isEmpty());
    }

    @Test
    public void testDdiNull() {
        var result = mapSingleCountry(null);

        assertNull(result.getCountries().get(0).getCode());
    }

    @Test
    public void testDdiBlank() {
        var result = mapSingleCountry("   ");

        assertNull(result.getCountries().get(0).getCode());
    }

    @Test
    public void testDdiWithoutNumericCharacters() {
        var result = mapSingleCountry("ABC");

        assertNull(result.getCountries().get(0).getCode());
    }

    @Test
    public void testDdiWithSpecialCharacters() {
        var result = mapSingleCountry("+55");

        assertEquals(result.getCountries().get(0).getCode(), Integer.valueOf(55));
    }

    private br.com.bradesco.next.contingency.pix.domain.dto.PixCountriesDto mapSingleCountry(String ddi) {
        var response = new CountryRootResponse();
        response.setListaPaises(Arrays.asList(country(ddi, "Teste")));
        return b2bCountriesMapper.toPixCountriesDto(response);
    }

    private CountryResponse country(String ddi, String nome) {
        var country = new CountryResponse();
        country.setDdi(ddi);
        country.setNome(nome);
        return country;
    }
}


