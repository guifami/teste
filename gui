package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryResponse;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryRootResponse;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountriesDto;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountryDto;
import org.mapstruct.Mapper;

import java.util.Collections;
import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

@Mapper(componentModel = "spring")
public interface B2bCountriesMapper {

    default PixCountriesDto toPixCountriesDto(CountryRootResponse response) {

        var result = new PixCountriesDto();

        List<PixCountryDto> countries = Optional
                .ofNullable(response)
                .map(CountryRootResponse::getListaPaises)
                .orElseGet(Collections::emptyList)
                .stream()
                .map(this::toPixCountryDto)
                .collect(Collectors.toList());

        result.setCountries(countries);

        return result;
    }

    default PixCountryDto toPixCountryDto(CountryResponse source) {

        var target = new PixCountryDto();

        target.setCode(parseDdi(source.getDdi()));
        target.setName(source.getNome());

        return target;
    }

    default Integer parseDdi(String ddi) {

        if (ddi == null || ddi.trim().isEmpty()) {
            return null;
        }

        String normalized = ddi
                .replace("+", "")
                .trim();

        try {
            return Integer.valueOf(normalized);
        } catch (NumberFormatException e) {
            return null;
        }
    }
}


