package br.com.bradesco.next.contingency.pix.service;

import br.com.bradesco.next.contingency.pix.b2b.client.contatos.api.ContatosApi;
import br.com.bradesco.next.contingency.pix.domain.dto.PixFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.dto.PixSearchRecordFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.mapper.core.B2bFavoredMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.support.StringBundle;
import org.springframework.stereotype.Service;

// manter os mesmos static imports usados no PixKeyValidationService:
// getCustomerInfo
// CHANNEL_ID

@Service
public class PixFavoredService {

    private static final String INTERNAL_BANK_CODE = "237";

    @Autowired
    private ContatosApi contatosApi;

    @Autowired
    private B2bFavoredMapper b2bFavoredMapper;

    @Autowired
    private StringBundle strings;

    @Value("${next-contingency-pix.cloud.x-access-token-pix.value}")
    private String xAccessTokenPix;

    public PixFavoredDto searchRecordFavored(PixSearchRecordFavoredDto requestDto) {
        var customerInfo = getCustomerInfo(strings);

        var request = b2bFavoredMapper.toRequest(
                requestDto.getKeyFavored(),
                INTERNAL_BANK_CODE,
                String.valueOf(customerInfo.getBranch()),
                String.valueOf(customerInfo.getAccountNumber()),
                String.valueOf(CHANNEL_ID)
        );

        var response = contatosApi.findRecord(xAccessTokenPix, request);
        return b2bFavoredMapper.toPixFavoredDto(response);
    }
}
