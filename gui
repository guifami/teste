package br.com.bradesco.next.pix.payment.utils;

import br.com.bradesco.next.pix.payment.domain.dto.PixPaymentM0076ContextDto;
import br.com.bradesco.next.pix.payment.domain.dto.PixPaymentM0076RuleResult;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.util.Optional;

import static br.com.bradesco.next.pix.payment.domain.enums.PixPaymentError.PIX_PAYMENT_SCHEDULE_DAILY_LIMIT_EXCEEDED_FOR_DATE;
import static br.com.bradesco.next.pix.payment.domain.enums.PixPaymentError.PIX_PAYMENT_SCHEDULE_NEXT_DAY_NIGHT_LIMIT_EXCEEDED;
import static br.com.bradesco.next.pix.payment.domain.enums.PixPaymentError.PIX_PAYMENT_SCHEDULE_SUM_LIMIT_EXCEEDED;
import static java.util.Objects.isNull;
import static java.util.Objects.nonNull;

public final class PixPaymentM0076RuleResolver {

    public static final String BSPI_ERROR_CODE_M0076 = "M0076";
    private static final BigDecimal SCHEDULE_NEXT_DAY_LIMIT = new BigDecimal("1000");
    private static final LocalTime NIGHT_WINDOW_START = LocalTime.of(20, 0);
    private static final LocalTime NIGHT_WINDOW_END = LocalTime.of(23, 59, 59);
    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("dd/MM/yyyy");

    private PixPaymentM0076RuleResolver() { throw new IllegalStateException("Utility class"); }

    public static boolean isM0076(String bspiReturnCode) { return BSPI_ERROR_CODE_M0076.equals(bspiReturnCode); }

    public static Optional<PixPaymentM0076RuleResult> resolve(PixPaymentM0076ContextDto context) {
        if (isNull(context)) return Optional.empty();

        boolean differentOwnership = isDifferentOwnership(context.sameOwnership());
        boolean nextDaySchedule = isNextDay(context.scheduledDate());
        boolean createdOnNightWindow = isOnNightWindow(context.creationDateTime());
        BigDecimal amount = ofNullableAmount(context.transactionAmount());

        if (differentOwnership && nextDaySchedule && createdOnNightWindow) {
            if (amount.compareTo(SCHEDULE_NEXT_DAY_LIMIT) > 0) {
                String nextAvailableDate = nonNull(context.nextAvailableDate()) ? context.nextAvailableDate().format(DATE_FORMATTER) : "";
                return Optional.of(PixPaymentM0076RuleResult.of(PIX_PAYMENT_SCHEDULE_NEXT_DAY_NIGHT_LIMIT_EXCEEDED, nextAvailableDate));
            }

            BigDecimal alreadyScheduledForDate = ofNullableAmount(context.existingScheduledAmountForDate());
            if (alreadyScheduledForDate.add(amount).compareTo(SCHEDULE_NEXT_DAY_LIMIT) > 0) return Optional.of(PixPaymentM0076RuleResult.of(PIX_PAYMENT_SCHEDULE_SUM_LIMIT_EXCEEDED));
        }

        if (Boolean.TRUE.equals(context.isAgendamento())) return Optional.of(PixPaymentM0076RuleResult.of(PIX_PAYMENT_SCHEDULE_DAILY_LIMIT_EXCEEDED_FOR_DATE));

        return Optional.empty();
    }

    private static BigDecimal ofNullableAmount(BigDecimal amount) { return isNull(amount) ? BigDecimal.ZERO : amount; }

    private static boolean isDifferentOwnership(Boolean sameOwnership) { return !Boolean.TRUE.equals(sameOwnership); }

    private static boolean isNextDay(LocalDate scheduledDate) { return nonNull(scheduledDate) && scheduledDate.isEqual(LocalDate.now().plusDays(1)); }

    private static boolean isOnNightWindow(LocalDateTime creationDateTime) {
        if (isNull(creationDateTime)) return false;
        LocalTime time = creationDateTime.toLocalTime();
        return !time.isBefore(NIGHT_WINDOW_START) && !time.isAfter(NIGHT_WINDOW_END);
    }
}


