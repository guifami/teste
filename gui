import br.com.bradesco.next.pix.payment.domain.dto.PixPaymentM0076RuleResult;


// SUBSTITUA SEU resolveM0076Rule INTEIRO POR ESTE:
private PixPaymentM0076RuleResult resolveM0076Rule(String bspiReturnCode, PixPaymentDto pixPaymentDto, NextError defaultError, String token) {
    if (!PixPaymentM0076RuleResolver.isM0076(bspiReturnCode)) return PixPaymentM0076RuleResult.of(defaultError);

    PixPaymentScheduleDto schedule = pixPaymentDto.getSchedule();
    LocalDate scheduleDate = nonNull(schedule) ? schedule.getScheduleDate() : null;
    BigDecimal existingScheduledAmount = nonNull(scheduleDate) ? pixScheduleQueryService.getScheduledAmountForDate(token, scheduleDate) : BigDecimal.ZERO;

    var context = new PixPaymentM0076ContextDto(pixPaymentDto.getTransactionAmount(), pixPaymentDto.isSameOwnership(), scheduleDate, LocalDateTime.now(), nonNull(schedule), existingScheduledAmount, nonNull(scheduleDate) ? scheduleDate.plusDays(1) : null);

    return PixPaymentM0076RuleResolver.resolve(context).orElse(PixPaymentM0076RuleResult.of(defaultError));
}


