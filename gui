package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.FavrDTOWithoutChannel;
import br.com.bradesco.next.contingency.pix.domain.enums.PixAccountTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixFavoredTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationStatusEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationTypeFavoredEnum;
import org.mapstruct.factory.Mappers;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import java.time.LocalDateTime;

import static org.testng.Assert.*;

public class B2bFavoredMapperTest {

    private B2bFavoredMapper b2bFavoredMapper;

    @BeforeMethod
    public void setUp() {
        b2bFavoredMapper = Mappers.getMapper(B2bFavoredMapper.class);
    }

    @Test
    public void testResponseToDto() {
        var response = getFavoredResponse();

        var result = b2bFavoredMapper.responseToDto(response);

        assertNotNull(result);
        assertEquals(result.getPartition(), Integer.valueOf(161));
        assertEquals(result.getFavoredCode(), 1L);

        // Não existem equivalentes no gateway novo
        assertEquals(result.getLegalPersonCodeFavored(), 0L);
        assertNull(result.getContractTypeCodeFavored());
        assertEquals(result.getContractSequentialNumberFavored(), 0L);

        assertEquals(result.getCpfCnpjFavored(), "718299921");
        assertEquals(result.getIspbCodeFavored(), Integer.valueOf(60746948));
        assertEquals(result.getBankFavored(), Integer.valueOf(0));
        assertEquals(result.getBranchFavored(), Integer.valueOf(0));
        assertEquals(result.getAccountFavored(), Long.valueOf(0));
        assertEquals(result.getDigitFavored(), Integer.valueOf(0));

        assertEquals(result.getTypeAccount(), PixAccountTypeEnum.fromValue("CACC"));
        assertEquals(result.getKey(), "71829992180");
        assertEquals(result.getName(), "FULANO BELTRANO DA SILVA PERFIL NOVO");
        assertEquals(result.getInput(), PixRegistrationTypeFavoredEnum.fromValue("CPF_CNPJ"));
        assertEquals(result.getRegister(), PixFavoredTypeEnum.fromValue("FAVORITO"));
        assertEquals(result.getRegistrationStatus(), PixRegistrationStatusEnum.fromValue("ATIVO"));
        assertEquals(
                result.getStartValidityDate(),
                LocalDateTime.parse("2026-08-14T17:08:15.061")
        );
    }

    @Test
    public void testResponseToDtoNull() {
        assertNull(b2bFavoredMapper.responseToDto(null));
    }

    @Test
    public void testResponseToDtoWithNullEnumsAndDate() {
        var response = new FavrDTOWithoutChannel();

        var result = b2bFavoredMapper.responseToDto(response);

        assertNotNull(result);
        assertNull(result.getTypeAccount());
        assertNull(result.getInput());
        assertNull(result.getRegister());
        assertNull(result.getRegistrationStatus());
        assertNull(result.getStartValidityDate());
    }

    @Test
    public void testResponseToDtoWithBlankDate() {
        var response = new FavrDTOWithoutChannel();
        response.setDataInicioValidade(" ");

        var result = b2bFavoredMapper.responseToDto(response);

        assertNotNull(result);
        assertNull(result.getStartValidityDate());
    }

    @Test
    public void testTipoContaMapping() {
        assertEquals(
                b2bFavoredMapper.map(FavrDTOWithoutChannel.TipoContaEnum.CACC),
                PixAccountTypeEnum.fromValue("CACC")
        );
        assertNull(b2bFavoredMapper.map((FavrDTOWithoutChannel.TipoContaEnum) null));
    }

    @Test
    public void testEntradaMapping() {
        assertEquals(
                b2bFavoredMapper.map(FavrDTOWithoutChannel.EntradaEnum.CPF_CNPJ),
                PixRegistrationTypeFavoredEnum.fromValue("CPF_CNPJ")
        );
        assertNull(b2bFavoredMapper.map((FavrDTOWithoutChannel.EntradaEnum) null));
    }

    @Test
    public void testCadastroMapping() {
        assertEquals(
                b2bFavoredMapper.map(FavrDTOWithoutChannel.CadastroEnum.FAVORITO),
                PixFavoredTypeEnum.fromValue("FAVORITO")
        );
        assertNull(b2bFavoredMapper.map((FavrDTOWithoutChannel.CadastroEnum) null));
    }

    @Test
    public void testStatusCadastroMapping() {
        assertEquals(
                b2bFavoredMapper.map(FavrDTOWithoutChannel.StatusCadastroEnum.ATIVO),
                PixRegistrationStatusEnum.fromValue("ATIVO")
        );
        assertNull(b2bFavoredMapper.map((FavrDTOWithoutChannel.StatusCadastroEnum) null));
    }

    @Test
    public void testDateMapping() {
        assertEquals(
                b2bFavoredMapper.map("2026-08-14 17:08:15.061"),
                LocalDateTime.parse("2026-08-14T17:08:15.061")
        );
        assertNull(b2bFavoredMapper.map((String) null));
        assertNull(b2bFavoredMapper.map(" "));
    }

    private FavrDTOWithoutChannel getFavoredResponse() {
        var response = new FavrDTOWithoutChannel();
        response.setParticao("161");
        response.setBanco("237");
        response.setAgencia("3750");
        response.setConta("49161");
        response.setCodigoFavorecido("1");
        response.setCcpfCnpjFavorecido("718299921");
        response.setCfilialCnpjFavorecido("0000");
        response.setCctrlCpfFavorecido("80");
        response.setCispbBacenFavorecido("60746948");
        response.setBancoFavorecido("0");
        response.setAgenciaFavorecido("0");
        response.setContaFavorecido("0");
        response.setDigitoFavorecido("0");
        response.setTipoConta(FavrDTOWithoutChannel.TipoContaEnum.CACC);
        response.setChave("71829992180");
        response.setNome("FULANO BELTRANO DA SILVA PERFIL NOVO");
        response.setEntrada(FavrDTOWithoutChannel.EntradaEnum.CPF_CNPJ);
        response.setCadastro(FavrDTOWithoutChannel.CadastroEnum.FAVORITO);
        response.setDataInicioValidade("2026-08-14 17:08:15.061");
        response.setStatusCadastro(FavrDTOWithoutChannel.StatusCadastroEnum.ATIVO);
        return response;
    }
}
