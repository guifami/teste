package br.com.bradesco.next.contingency.pix.service;

import br.com.bradesco.next.common.strings.StringBundle;
import br.com.bradesco.next.common.web.exception.UnprocessableEntityException;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.api.ListaDePaisesApi;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountriesDto;
import br.com.bradesco.next.contingency.pix.domain.mapper.core.b2b.B2bCountriesMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;

import static br.com.bradesco.next.contingency.pix.domain.enums.PixError.PIX_COUNTRIES_EMPTY_LIST;

@Service
public class PixCountriesService {

    private static final Logger LOG = LoggerFactory.getLogger(PixCountriesService.class);
    private static final String COUNTRIES_CACHE_CATEGORY = "countries";

    @Autowired
    private ListaDePaisesApi listaDePaisesApi;

    @Autowired
    private B2bCountriesMapper b2bCountriesMapper;

    @Autowired
    private StringBundle strings;

    @Cacheable(value = COUNTRIES_CACHE_CATEGORY)
    public PixCountriesDto queryCountries() {
        var response = listaDePaisesApi.callList();

        if (response == null || response.getListaPaises() == null || response.getListaPaises().isEmpty()) {
            LOG.error("Countries list is empty or null.");
            throw new UnprocessableEntityException(
                    PIX_COUNTRIES_EMPTY_LIST.getCode(),
                    PIX_COUNTRIES_EMPTY_LIST,
                    strings
            );
        }

        return b2bCountriesMapper.toPixCountriesDto(response);
    }
}


