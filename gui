import br.com.bradesco.next.contingency.pix.b2b.client.contatos.api.ContatosApi;
import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.RequestFindRecordDTO;
import br.com.bradesco.next.contingency.pix.domain.dto.PixFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.dto.PixSearchRecordFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.mapper.core.B2bFavoredMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.util.ResourceBundle;

import static br.com.bradesco.next.contingency.pix.utils.ApplicationUtils.getCustomerInfo;

// ajuste estes static imports para os mesmos usados no PixKeyValidationService
import static br.com.bradesco.next.contingency.pix.domain.constants.PixConstants.CHANNEL_ID;

@Service
public class PixFavoredService {

    /*
     * Banco Bradesco.
     *
     * Estou deixando local para não depender do nome exato da
     * constante do seu projeto.
     *
     * Se vocês já tiverem INTERNAL_BANK_CODE = "237",
     * substitua por essa constante.
     */
    private static final String INTERNAL_BANK_CODE = "237";

    @Autowired
    private ContatosApi contatosApi;

    @Autowired
    private B2bFavoredMapper b2bFavoredMapper;

    @Autowired
    private ResourceBundle strings;

    @Value("${next-contingency-pix.cloud.x-access-token-pix.value}")
    private String xAccessTokenPix;

    public PixFavoredDto searchRecordFavored(
            PixSearchRecordFavoredDto pixSearchRecordFavoredRequestDto) {

        var customerInfo = getCustomerInfo(strings);

        var request = new RequestFindRecordDTO();

        /*
         * Mesmo conceito usado no ChavesApi:
         *
         * x-access-token-pix
         * banco/agência/conta/canal do cliente
         * chave que está sendo pesquisada
         */

        request.setCtpoCanal(
                String.valueOf(CHANNEL_ID)
        );

        request.setBanco(
                INTERNAL_BANK_CODE
        );

        request.setAgencia(
                customerInfo.getBranch() != null
                        ? String.valueOf(customerInfo.getBranch())
                        : null
        );

        request.setConta(
                customerInfo.getAccountNumber() != null
                        ? String.valueOf(customerInfo.getAccountNumber())
                        : null
        );

        request.setChave(
                pixSearchRecordFavoredRequestDto.getKeyFavored()
        );

        /*
         * Os campos abaixo são referentes à busca por dados
         * específicos do favorecido.
         *
         * Como o contrato atual da sua controller recebe apenas
         * keyFavored, eles devem continuar null.
         *
         * O gateway B2B fará a consulta pela chave.
         */
        request.setCispbBacenFavorecido(null);
        request.setAgenciaFavorecido(null);
        request.setContaFavorecido(null);
        request.setDigitoFavorecido(null);
        request.setCodigoFavorecido(null);

        var response = contatosApi.findRecord(
                xAccessTokenPix,
                request
        );

        return b2bFavoredMapper.toPixFavoredDto(response);
    }
}


