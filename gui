package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.FavrDTOWithoutChannel;
import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.RequestFindRecordDTO;
import br.com.bradesco.next.contingency.pix.domain.dto.PixFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.enums.PixAccountTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixFavoredTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationStatusEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationTypeFavoredEnum;
import org.mapstruct.AfterMapping;
import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.MappingTarget;

import java.time.LocalDateTime;

import static br.com.bradesco.next.common.util.NextApiUtils.CHANNEL_ID;
import static br.com.bradesco.next.common.util.NextApiUtils.INTERNAL_BANK_CODE;
import static br.com.bradesco.next.common.util.NextApiUtils.INTERNAL_BANK_ISPB;

@Mapper(componentModel = "spring")
public abstract class B2bFavoredMapper {

    @Mapping(target = "agencia", source = "customerInfo.branch")
    @Mapping(target = "conta", source = "customerInfo.accountNumber")
    @Mapping(target = "chave", source = "key")
    @Mapping(target = "cispbBacenFavorecido", constant = INTERNAL_BANK_ISPB)
    @Mapping(target = "ctpoCanal", ignore = true)
    @Mapping(target = "banco", ignore = true)
    @Mapping(target = "agenciaFavorecido", ignore = true)
    @Mapping(target = "contaFavorecido", ignore = true)
    @Mapping(target = "digitoFavorecido", ignore = true)
    @Mapping(target = "codigoFavorecido", ignore = true)
    public abstract RequestFindRecordDTO toRequest(String key, CustomerInfo customerInfo);

    @AfterMapping
    protected void afterMapping(@MappingTarget RequestFindRecordDTO request) {
        request.setCtpoCanal(String.valueOf(CHANNEL_ID));
        request.setBanco(String.valueOf(INTERNAL_BANK_CODE));
    }

    @Mapping(target = "partition", source = "particao")
    @Mapping(target = "favoredCode", source = "codigoFavorecido")
    @Mapping(target = "legalPersonCodeFavored", ignore = true)
    @Mapping(target = "contractTypeCodeFavored", ignore = true)
    @Mapping(target = "contractSequentialNumberFavored", ignore = true)
    @Mapping(target = "cpfCnpjFavored", source = "ccpfCnpjFavorecido")
    @Mapping(target = "ispbCodeFavored", source = "cispbBacenFavorecido")
    @Mapping(target = "bankFavored", source = "bancoFavorecido")
    @Mapping(target = "branchFavored", source = "agenciaFavorecido")
    @Mapping(target = "accountFavored", source = "contaFavorecido")
    @Mapping(target = "digitFavored", source = "digitoFavorecido")
    @Mapping(target = "typeAccount", source = "tipoConta")
    @Mapping(target = "key", source = "chave")
    @Mapping(target = "name", source = "nome")
    @Mapping(target = "input", source = "entrada")
    @Mapping(target = "register", source = "cadastro")
    @Mapping(target = "startValidityDate", source = "dataInicioValidade")
    @Mapping(target = "registrationStatus", source = "statusCadastro")
    public abstract PixFavoredDto responseToDto(FavrDTOWithoutChannel response);

    protected PixAccountTypeEnum map(FavrDTOWithoutChannel.TipoContaEnum value) {
        return value == null ? null : PixAccountTypeEnum.valueOf(value.name());
    }

    protected PixRegistrationTypeFavoredEnum map(FavrDTOWithoutChannel.EntradaEnum value) {
        return value == null ? null : PixRegistrationTypeFavoredEnum.valueOf(value.name());
    }

    protected PixFavoredTypeEnum map(FavrDTOWithoutChannel.CadastroEnum value) {
        return value == null ? null : PixFavoredTypeEnum.valueOf(value.name());
    }

    protected PixRegistrationStatusEnum map(FavrDTOWithoutChannel.StatusCadastroEnum value) {
        return value == null ? null : PixRegistrationStatusEnum.valueOf(value.name());
    }

    protected LocalDateTime map(String value) {
        return value == null || value.isBlank() ? null : LocalDateTime.parse(value);
    }
}


