package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.contatos.model.FavrDTOWithoutChannel;
import br.com.bradesco.next.contingency.pix.domain.dto.PixFavoredDto;
import br.com.bradesco.next.contingency.pix.domain.enums.PixAccountTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixFavoredTypeEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationStatusEnum;
import br.com.bradesco.next.contingency.pix.domain.enums.PixRegistrationTypeFavoredEnum;
import org.mapstruct.Mapper;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;

@Mapper(componentModel = "spring")
public interface B2bFavoredMapper {

    default PixFavoredDto toPixFavoredDto(FavrDTOWithoutChannel source) {

        if (source == null) {
            return null;
        }

        var target = new PixFavoredDto();

        target.setPartition(parseInteger(source.getParticao()));

        target.setFavoredCode(parseLong(source.getCodigoFavorecido()));

        /*
         * ATENÇÃO:
         *
         * Estes três são a equivalência mais provável entre
         * o contrato B2B novo e o DTO legado.
         *
         * Recomendo conferir contra o responseToDto() do
         * BspiFavoredMapper antigo antes do merge.
         */
        target.setLegalPersonCodeFavored(
                parseLong(source.getCcpfCnpjFavorecido())
        );

        target.setContractTypeCodeFavored(
                parseInteger(source.getCfilialCnpjFavorecido())
        );

        target.setContractSequentialNumberFavored(
                parseLong(source.getCctrlCpfFavorecido())
        );

        target.setCpfCnpjFavored(
                buildCpfCnpj(
                        source.getCcpfCnpjFavorecido(),
                        source.getCfilialCnpjFavorecido(),
                        source.getCctrlCpfFavorecido()
                )
        );

        target.setIspbCodeFavored(
                parseInteger(source.getCispbBacenFavorecido())
        );

        target.setBankFavored(
                parseInteger(source.getBancoFavorecido())
        );

        target.setBranchFavored(
                parseInteger(source.getAgenciaFavorecido())
        );

        target.setAccountFavored(
                parseLong(source.getContaFavorecido())
        );

        target.setDigitFavored(
                parseInteger(source.getDigitoFavorecido())
        );

        target.setTypeAccount(
                mapTypeAccount(source)
        );

        target.setKey(source.getChave());

        target.setName(source.getNome());

        target.setInput(
                mapInput(source)
        );

        target.setRegister(
                mapRegister(source)
        );

        target.setStartValidityDate(
                parseLocalDateTime(source.getDataInicioValidade())
        );

        target.setRegistrationStatus(
                mapRegistrationStatus(source)
        );

        return target;
    }

    default PixAccountTypeEnum mapTypeAccount(
            FavrDTOWithoutChannel source) {

        if (source.getTipoConta() == null) {
            return null;
        }

        try {
            return PixAccountTypeEnum.valueOf(
                    source.getTipoConta().name()
            );
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    default PixRegistrationTypeFavoredEnum mapInput(
            FavrDTOWithoutChannel source) {

        if (source.getEntrada() == null) {
            return null;
        }

        try {
            return PixRegistrationTypeFavoredEnum.valueOf(
                    source.getEntrada().name()
            );
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    default PixFavoredTypeEnum mapRegister(
            FavrDTOWithoutChannel source) {

        if (source.getCadastro() == null) {
            return null;
        }

        try {
            return PixFavoredTypeEnum.valueOf(
                    source.getCadastro().name()
            );
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    default PixRegistrationStatusEnum mapRegistrationStatus(
            FavrDTOWithoutChannel source) {

        if (source.getStatusCadastro() == null) {
            return null;
        }

        try {
            return PixRegistrationStatusEnum.valueOf(
                    source.getStatusCadastro().name()
            );
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    default Integer parseInteger(String value) {

        if (value == null || value.trim().isEmpty()) {
            return null;
        }

        try {
            return Integer.valueOf(
                    value.replaceAll("\\D", "")
            );
        } catch (NumberFormatException e) {
            return null;
        }
    }

    default Long parseLong(String value) {

        if (value == null || value.trim().isEmpty()) {
            return null;
        }

        try {
            return Long.valueOf(
                    value.replaceAll("\\D", "")
            );
        } catch (NumberFormatException e) {
            return null;
        }
    }

    default String buildCpfCnpj(
            String codigo,
            String filial,
            String controle) {

        if (codigo == null) {
            return null;
        }

        StringBuilder result = new StringBuilder(codigo);

        if (filial != null) {
            result.append(filial);
        }

        if (controle != null) {
            result.append(controle);
        }

        return result.toString();
    }

    default LocalDateTime parseLocalDateTime(String value) {

        if (value == null || value.trim().isEmpty()) {
            return null;
        }

        try {
            return LocalDateTime.parse(value);
        } catch (DateTimeParseException ignored) {
        }

        try {
            return LocalDateTime.parse(
                    value,
                    DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")
            );
        } catch (DateTimeParseException ignored) {
        }

        try {
            return LocalDateTime.parse(
                    value,
                    DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss")
            );
        } catch (DateTimeParseException ignored) {
        }

        return null;
    }
}


