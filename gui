public PaymentRequestDTOV2 toPaymentRequestDTOV2(
        PixPaymentDto dto,
        CustomerInfo customerInfo) {

    PaymentRequestDTOV2 request = new PaymentRequestDTOV2();

    // ------------------------------------------------------------------------
    // DADOS BÁSICOS
    // ------------------------------------------------------------------------

    request.setCanal(String.valueOf(CHANNEL_ID));

    // Endpoint atual é validação/intenção online.
    request.setTipoExecucao(
            PaymentRequestDTOV2.TipoExecucaoEnum.O
    );

    // ------------------------------------------------------------------------
    // TIPO DE INICIAÇÃO
    //
    // PixInputMethodEnum possui codeInd:
    // MANU / DICT / QRES / QRDN / ...
    // ------------------------------------------------------------------------

    if (dto.getInputMethod() != null &&
            dto.getInputMethod().getCodeInd() != null) {

        request.setTipoIniciacao(
                PaymentRequestDTOV2.TipoIniciacaoEnum.fromValue(
                        dto.getInputMethod().getCodeInd()
                )
        );
    }

    // ------------------------------------------------------------------------
    // FINALIDADE DA TRANSAÇÃO
    //
    // IPAY / OTHR / GSCB
    // ------------------------------------------------------------------------

    if (dto.getPixTransPurposeEnum() != null) {

        request.setFinalidadeTransacao(
                PaymentRequestDTOV2.FinalidadeTransacaoEnum.fromValue(
                        dto.getPixTransPurposeEnum().getValue()
                )
        );
    }

    // ------------------------------------------------------------------------
    // VALOR
    // ------------------------------------------------------------------------

    if (dto.getTransactionAmount() != null) {

        request.setValor(
                dto.getTransactionAmount()
                        .setScale(2, RoundingMode.HALF_UP)
                        .toPlainString()
        );
    }

    // ------------------------------------------------------------------------
    // DESCRIÇÃO
    // ------------------------------------------------------------------------

    request.setDescricao(dto.getDescription());

    // ------------------------------------------------------------------------
    // E2E
    //
    // No contrato atual do contingency, confirmationCode é o identificador
    // de 32 caracteres utilizado na validação.
    // ------------------------------------------------------------------------

    request.setE2e(dto.getConfirmationCode());

    // ------------------------------------------------------------------------
    // CHAVE PIX
    // ------------------------------------------------------------------------

    request.setChave(
            createPaymentChave(dto)
    );

    // ------------------------------------------------------------------------
    // CONTA DO DEBITADO
    // ------------------------------------------------------------------------

    request.setDebito(
            createPaymentDebito(
                    dto,
                    customerInfo
            )
    );

    // ------------------------------------------------------------------------
    // CONTA DO CREDITADO
    // ------------------------------------------------------------------------

    request.setCredito(
            createPaymentCredito(dto)
    );

    // ------------------------------------------------------------------------
    // LIOP
    // ------------------------------------------------------------------------

    request.setLiop(
            createPaymentLiop(dto)
    );

    // ------------------------------------------------------------------------
    // CAFD
    // ------------------------------------------------------------------------

    request.setCafd(
            createPaymentCafd(
                    dto.getCafdConfirmationDto()
            )
    );

    // ------------------------------------------------------------------------
    // RECURSOS QUE NÃO SÃO UTILIZADOS POR ESTE ENDPOINT LEGADO
    // ------------------------------------------------------------------------

    request.setUtilizaCartaoCredito(Boolean.FALSE);
    request.setUtilizaBiometria(Boolean.FALSE);

    return request;
}


// ============================================================================
// CHAVE PIX
// ============================================================================

private ChaveDTO createPaymentChave(PixPaymentDto dto) {

    if (dto.getRecipientKeyType() == null ||
            PixNumericKeyTypeEnum.BRANCH_ACCOUNT.equals(
                    dto.getRecipientKeyType()
            )) {

        return null;
    }

    ChaveDTO chave = new ChaveDTO();

    switch (dto.getRecipientKeyType()) {

        case EMAIL:

            chave.setTipo(
                    ChaveDTO.TipoEnum.EMAIL
            );

            break;

        case PHONE:

            chave.setTipo(
                    ChaveDTO.TipoEnum.CELULAR
            );

            break;

        case CPF_CNPJ:

            chave.setTipo(
                    ChaveDTO.TipoEnum.CPF_CNPJ
            );

            break;

        case EVP:

            chave.setTipo(
                    ChaveDTO.TipoEnum.EVP
            );

            break;

        default:

            return null;
    }

    chave.setValor(
            dto.getRecipientKey()
    );

    return chave;
}


// ============================================================================
// CONTA DO DEBITADO
// ============================================================================

private DebitoDTO createPaymentDebito(
        PixPaymentDto dto,
        CustomerInfo customerInfo) {

    DebitoDTO debito = new DebitoDTO();

    // Mesmos dados que o mapper antigo colocava no
    // BspiEffectiveLaunchV4Request.

    debito.setIspb(
            String.valueOf(INTERNAL_BANK_ISPB)
    );

    debito.setBanco(
            String.valueOf(INTERNAL_BANK_CODE)
    );

    if (customerInfo != null) {

        if (customerInfo.getBranch() != null) {

            debito.setAgencia(
                    String.valueOf(
                            customerInfo.getBranch()
                    )
            );
        }

        if (customerInfo.getAccountNumber() != null) {

            debito.setConta(
                    String.valueOf(
                            customerInfo.getAccountNumber()
                    )
            );

            debito.setDigitoConta(
                    getAccountDigit(
                            customerInfo.getAccountNumber()
                    )
            );
        }
    }

    // ------------------------------------------------------------------------
    // TIPO DA CONTA DO PAGADOR
    // ------------------------------------------------------------------------

    if (dto.getSenderAccountType() != null) {

        switch (dto.getSenderAccountType()) {

            case CURRENT:

                debito.setTipoConta(
                        DebitoDTO.TipoContaEnum.CACC
                );

                break;

            case SAVING:

                debito.setTipoConta(
                        DebitoDTO.TipoContaEnum.SVGS
                );

                break;

            default:
                break;
        }
    }

    // ------------------------------------------------------------------------
    // NOME DO PAGADOR
    //
    // O mapper antigo também buscava o BankingCustomer para preencher
    // senderName.
    // ------------------------------------------------------------------------

    try {

        var bankingCustomer =
                customerService.findBankingCustomer();

        if (bankingCustomer != null) {

            debito.setNome(
                    truncateToMaxChars(
                            bankingCustomer.getName(),
                            KEY_CREATION_TRUNCATE_SENDERNAME
                    )
            );
        }

    } catch (RuntimeException ignored) {

        // Não quebra a montagem da intenção por causa do nome.
    }

    return debito;
}


// ============================================================================
// CONTA DO CREDITADO
// ============================================================================

private CreditoDTO createPaymentCredito(
        PixPaymentDto dto) {

    CreditoDTO credito = new CreditoDTO();

    // ------------------------------------------------------------------------
    // ISPB
    // ------------------------------------------------------------------------

    if (dto.getRecipientIspbCode() != null) {

        credito.setIspb(
                getFormattedIspb(
                        dto.getRecipientIspbCode()
                )
        );
    }

    // ------------------------------------------------------------------------
    // AGÊNCIA
    // ------------------------------------------------------------------------

    if (dto.getRecipientBranch() != null) {

        credito.setAgencia(
                String.valueOf(
                        dto.getRecipientBranch()
                )
        );
    }

    // ------------------------------------------------------------------------
    // CONTA
    // ------------------------------------------------------------------------

    if (dto.getRecipientAccount() != null) {

        credito.setConta(
                String.valueOf(
                        dto.getRecipientAccount()
                )
        );
    }

    // ------------------------------------------------------------------------
    // DÍGITO DA CONTA
    // ------------------------------------------------------------------------

    if (dto.getRecipientAccountDigit() != null) {

        credito.setDigitoConta(
                String.valueOf(
                        dto.getRecipientAccountDigit()
                )
        );
    }

    // ------------------------------------------------------------------------
    // NOME DO RECEBEDOR
    // ------------------------------------------------------------------------

    if (dto.getRecipientName() != null) {

        credito.setNome(
                truncateToMaxChars(
                        dto.getRecipientName(),
                        KEY_CREATION_TRUNCATE_RECIPIENT_NAME
                )
        );
    }

    // ------------------------------------------------------------------------
    // TIPO DA CONTA DO RECEBEDOR
    //
    // CURRENT         -> CACC
    // SAVING          -> SVGS
    // PAYMENT_ACCOUNT -> TRAN
    // ------------------------------------------------------------------------

    if (dto.getRecipientAccountType() != null) {

        switch (dto.getRecipientAccountType()) {

            case CURRENT:

                credito.setTipoConta(
                        CreditoDTO.TipoContaEnum.CACC
                );

                break;

            case SAVING:

                credito.setTipoConta(
                        CreditoDTO.TipoContaEnum.SVGS
                );

                break;

            case PAYMENT_ACCOUNT:

                credito.setTipoConta(
                        CreditoDTO.TipoContaEnum.TRAN
                );

                break;

            default:
                break;
        }
    }

    return credito;
}


// ============================================================================
// LIOP
// ============================================================================

private LiopDTO createPaymentLiop(
        PixPaymentDto dto) {

    LiopDTO liop = new LiopDTO();

    liop.setCanal(
            String.valueOf(CHANNEL_ID)
    );

    if (dto.getInputMethod() != null) {

        if (dto.getInputMethod().getLimitServiceCode() != null) {

            liop.setServico(
                    String.valueOf(
                            dto.getInputMethod()
                                    .getLimitServiceCode()
                    )
            );
        }

        if (dto.getInputMethod().getMagicLimitServiceCode() != null) {

            liop.setServicoRetirada(
                    String.valueOf(
                            dto.getInputMethod()
                                    .getMagicLimitServiceCode()
                    )
            );
        }
    }

    return liop;
}


// ============================================================================
// CAFD
// ============================================================================

private CafdDTOV2 createPaymentCafd(
        CafdConfirmationDto dto) {

    CafdDTOV2 cafd = new CafdDTOV2();

    cafd.setCanal(
            String.valueOf(CHANNEL_ID)
    );

    // ------------------------------------------------------------------------
    // É INTENÇÃO/VALIDAÇÃO.
    //
    // Mesmo comportamento que o mapper antigo:
    //
    // request.setCodeA(EMPTY_STRING);
    // request.setCafdProtocolNumber(BigDecimal.ZERO.toString());
    // ------------------------------------------------------------------------

    cafd.setCodigoA(
            EMPTY_STRING
    );

    cafd.setNumProtocoloCafd(
            BigDecimal.ZERO.toString()
    );

    if (dto == null) {
        return cafd;
    }

    cafd.setAgenteUsuario(
            dto.getUserAgent()
    );

    cafd.setCodSessao(
            dto.getSessionCode()
    );

    cafd.setEnderecoIp(
            dto.getIpAddress()
    );

    cafd.setPortaIp(
            dto.getIpPort()
    );

    cafd.setFormaAcesso(
            dto.getAccessForm()
    );

    cafd.setIdentEquipam(
            dto.getEquipmentIdentification()
    );

    cafd.setIdentRegDispos(
            dto.getIdentRegDevice()
    );

    cafd.setIdentVirtHard(
            dto.getIdentVirtHard()
    );

    cafd.setLatitude(
            dto.getLatitude()
    );

    cafd.setLongitude(
            dto.getLongitude()
    );

    cafd.setModDispositivo(
            dto.getModelDevice()
    );

    cafd.setNomeUsuario(
            dto.getUserName()
    );

    cafd.setPlataforma(
            dto.getPlatform()
    );

    return cafd;
}


// ============================================================================
// RESPONSE
//
// IntencaoResponseV2
//          |
//          +-- online
//                |
//                +-- info
//
// InfoIntencaoOnline:
// codigoA
// protocoloCafd
// e2e
// tarifa
// transacaoDuplicada
// saldo
// liop
// limite
// limites
// suspeitaFraude
// ============================================================================

public PixTransactionDto toPixTransactionDto(
        IntencaoResponseV2 response,
        PixPaymentDto pixPaymentDto) {

    if (response == null ||
            response.getOnline() == null ||
            response.getOnline().getInfo() == null) {

        throw new UnprocessableEntityException(
                PIX_GENERAL_ERROR.getCode(),
                PIX_GENERAL_ERROR,
                strings
        );
    }

    InfoIntencaoOnline info =
            response.getOnline().getInfo();

    PixTransactionDto dto =
            new PixTransactionDto();

    // ------------------------------------------------------------------------
    // DADOS ORIGINAIS DA TRANSAÇÃO
    //
    // No mapper antigo boa parte desses campos também vinha do
    // PixPaymentDto e não diretamente da resposta do core.
    // ------------------------------------------------------------------------

    dto.setRecipientName(
            pixPaymentDto.getRecipientName()
    );

    dto.setRecipientCpfCnpj(
            getPaymentRecipientCpfCnpj(
                    pixPaymentDto
            )
    );

    dto.setRecipientBank(
            pixPaymentDto.getRecipientBank()
    );

    dto.setRecipientKey(
            pixPaymentDto.getRecipientKey()
    );

    dto.setDescription(
            pixPaymentDto.getDescription()
    );

    dto.setAmount(
            pixPaymentDto.getTransactionAmount()
    );

    dto.setRecipientAccount(
            pixPaymentDto.getRecipientAccount()
    );

    dto.setRecipientBranch(
            pixPaymentDto.getRecipientBranch()
    );

    dto.setSameOwnership(
            pixPaymentDto.getSameOwnership()
    );

    dto.setPixTransPurposeEnum(
            pixPaymentDto.getPixTransPurposeEnum()
    );

    // ------------------------------------------------------------------------
    // TIPO DA CONTA DO RECEBEDOR
    // ------------------------------------------------------------------------

    if (pixPaymentDto.getRecipientAccountType() != null) {

        dto.setRecipientAccountType(
                getPixRecipientAccountType(
                        pixPaymentDto.getRecipientAccountType()
                )
        );
    }

    // ------------------------------------------------------------------------
    // E2E RETORNADO PELO NOVO GATEWAY
    // ------------------------------------------------------------------------

    dto.setConfirmationCode(
            info.getE2e()
    );

    // ------------------------------------------------------------------------
    // INTERNAL CODE
    //
    // O contrato externo NÃO MUDA.
    //
    // Antes o mapper criava o internalCode através de:
    //
    // cafdProtocolNumber + codeA
    //
    // Agora fazemos exatamente a mesma coisa usando:
    //
    // protocoloCafd + codigoA
    // ------------------------------------------------------------------------

    String protocoloCafd =
            info.getProtocoloCafd() != null
                    ? String.valueOf(
                            info.getProtocoloCafd()
                    )
                    : BigDecimal.ZERO.toString();

    String codigoA =
            info.getCodigoA() != null
                    ? info.getCodigoA().getValue()
                    : EMPTY_STRING;

    dto.setInternalCode(
            encodeInternalCode(
                    protocoloCafd,
                    codigoA
            )
    );

    // ------------------------------------------------------------------------
    // TARIFA
    // ------------------------------------------------------------------------

    if (info.getTarifa() != null &&
            !info.getTarifa().trim().isEmpty()) {

        try {

            dto.setBankFeeAmount(
                    new BigDecimal(
                            info.getTarifa()
                                    .replace(",", ".")
                    )
            );

        } catch (NumberFormatException ignored) {

            dto.setBankFeeAmount(
                    BigDecimal.ZERO
            );
        }

    } else {

        dto.setBankFeeAmount(
                BigDecimal.ZERO
        );
    }

    // ------------------------------------------------------------------------
    // USO DE LIMITE
    // ------------------------------------------------------------------------

    if (info.getLimite() != null) {

        dto.setUsesLimitInPaymentEnum(
                PixUseLimitInPaymentEnum.getByExternalCode(
                        info.getLimite()
                )
        );
    }

    // ------------------------------------------------------------------------
    // LISTA DE LIMITES
    // ------------------------------------------------------------------------

    dto.setLimits(
            getPixUsedLimitsV3(
                    info.getLimites()
            )
    );

    // ------------------------------------------------------------------------
    // A API /v3/intencoes QUE VOCÊ MOSTROU NÃO RETORNA NSU.
    //
    // NÃO VAMOS INVENTAR confirmationNumber.
    // ------------------------------------------------------------------------

    dto.setConfirmationNumber(
            null
    );

    // ------------------------------------------------------------------------
    // Fluxo de intenção normal.
    // ------------------------------------------------------------------------

    dto.setAwaitingAnalysis(
            Boolean.FALSE
    );

    return dto;
}


// ============================================================================
// LIMITES
//
// Como a classe "Limite" gerada pelo gateway novo e o PixUsedLimitDto
// pertencem a contratos diferentes, usamos BeanUtils para copiar todos os
// campos de mesmo nome.
//
// Isso evita amarrar essa migração à implementação do client gerado.
// ============================================================================

private List<PixUsedLimitDto> getPixUsedLimitsV3(
        List<Limite> limites) {

    if (limites == null ||
            limites.isEmpty()) {

        return Collections.emptyList();
    }

    List<PixUsedLimitDto> result =
            new ArrayList<>();

    for (Limite limite : limites) {

        if (limite == null) {
            continue;
        }

        PixUsedLimitDto target =
                new PixUsedLimitDto();

        BeanUtils.copyProperties(
                limite,
                target
        );

        result.add(
                target
        );
    }

    return result;
}


// ============================================================================
// INTERNAL CODE
//
// SE ESSE MÉTODO JÁ EXISTE NO SEU BspiPaymentValidationMapper,
// NÃO DUPLIQUE.
//
// DEIXEI AQUI SOMENTE PARA A IMPLEMENTAÇÃO FICAR COMPLETA.
// ============================================================================

private String encodeInternalCode(
        String cafdProtocolNumber,
        String codeA) {

    try {

        Map<String, String> elements =
                new HashMap<>();

        elements.put(
                CAFD_PROTOCOL,
                cafdProtocolNumber
        );

        elements.put(
                INTERNAL_CODE,
                codeA
        );

        String json =
                writeJava8ValueAsString(
                        elements
                );

        return encryptionService.encryptDaily(
                json
        );

    } catch (JsonProcessingException e) {

        LOG.info(
                "Error while encode internal code",
                e
        );

        return EMPTY_STRING;
    }
}


