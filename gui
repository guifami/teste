package br.com.bradesco.next.contingency.pix.domain.mapper.core;

import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryResponse;
import br.com.bradesco.next.contingency.pix.b2b.client.listagens.model.CountryRootResponse;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountriesDto;
import br.com.bradesco.next.contingency.pix.domain.dto.PixCountryDto;
import org.springframework.stereotype.Component;

import java.util.Collections;
import java.util.Optional;
import java.util.stream.Collectors;

@Component
public class B2bCountriesMapper {

    public PixCountriesDto toPixCountriesDto(CountryRootResponse response) {
        var dto = new PixCountriesDto();
        dto.setCountries(Optional.ofNullable(response)
                .map(CountryRootResponse::getListaPaises)
                .orElseGet(Collections::emptyList)
                .stream()
                .map(this::toPixCountryDto)
                .collect(Collectors.toList()));
        return dto;
    }

    private PixCountryDto toPixCountryDto(CountryResponse response) {
        var dto = new PixCountryDto();
        dto.setCode(parseDdi(response.getDdi()));
        dto.setName(response.getNome());
        return dto;
    }

    private Integer parseDdi(String ddi) {
        if (ddi == null || ddi.isBlank()) return null;
        var value = ddi.replaceAll("[^0-9]", "");
        return value.isEmpty() ? null : Integer.valueOf(value);
    }
}


