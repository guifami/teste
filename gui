@Override
public PixUpdateLimitResponse updateLimit(String customerCpf, PixLimitUpdateRequest request) {
    try {
        validateScheduledPixLimit(customerCpf, request);

        UpdateLimitModel updateLimitModel = createUpdateLimitModel(request);
        UpdateLimitResponse updateLimitResponse = liopSelfManagementEngClient.createOrUpdateLimit(createHeader(customerCpf), updateLimitModel);

        String messageCode = ofNullable(updateLimitResponse).map(UpdateLimitResponse::getPayload).map(UpdateLimitPayload::getMessageCode).orElse(null);
